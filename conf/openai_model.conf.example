# OpenAI model selection
# Copy to openai_model.conf to customize (gitignored).
# OPENAI_MODEL env var overrides this file on startup.
#
# Examples of latest / premium ids:
#   gpt-6-luna, gpt-6-sol, gpt-6.1-sol, gpt-6-astra
#   gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol
#   gpt-5.5-pro, gpt-5.4-pro, gpt-5.2-pro

model = gpt-4.1-mini

# GPT-5 / GPT-6 reasoning models (optional; used when a gpt-5* or gpt-6* model is selected):
# reasoning_effort = low
# text_verbosity = medium
