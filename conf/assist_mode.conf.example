# Assist controls. Transcription and voice can both be on.
# vision is one of: off, window, screen
# browser_control acts in an attached Edge or Chrome tab. It starts off.
# non_it answers general questions and skips the IT topic path. It starts off.
# Rollback for the whole feature is ASSIST_MODES_ENABLED in assist_mode.py.
# Rollback for Non-IT is NON_IT_ENABLED in assist_mode.py.
transcription = true
voice = false
vision = off
browser_control = false
non_it = false
